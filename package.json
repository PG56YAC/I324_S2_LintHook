{
  "name": "i324-s2-linthook",
  "version": "1.0.0",
  "description": "Application to-do d'exercice : linter et hooks (module I324, CPNV)",
  "main": "src/index.js",
  "license": "MIT",
  "scripts": {
    "dev": "nodemon -L src/index.js",
